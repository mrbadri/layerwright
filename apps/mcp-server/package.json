    "figma-plugin",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "design-to-code",
    "auto-layout"
  ],
  "homepage": "https://github.com/shayan-m81/layerwright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayan-m81/layerwright.git",
    "directory": "apps/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/shayan-m81/layerwright/issues"
  },
  "license": "MIT",
  "author": "Shayan Montazeri",
