{
  "name": "claude-design-engineer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build -w @cde/figma-plugin",
    "typecheck": "tsc -p packages/core && tsc -p apps/mcp-server && tsc -p apps/figma-plugin",
    "test": "node --import tsx --test packages/core/test/*.test.ts apps/mcp-server/test/*.test.ts apps/figma-plugin/test/*.test.ts",
    "mcp": "tsx apps/mcp-server/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
